# -----------------------------------------------------------------------------
# Throwbacks Arcade — local environment (copy to .env.local)
# -----------------------------------------------------------------------------
# Server-only secrets: set in Netlify Site settings → Environment variables.
# NEXT_PUBLIC_* variables are embedded in the browser bundle at build time.
# -----------------------------------------------------------------------------

# reCAPTCHA v2 site key (public — shown in the contact form widget)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Contact form API (server-only — used by /api/contact)
RESEND_API_KEY=
RESEND_FROM=Throwbacks Arcade <forms@your-verified-domain.com>
CONTACT_INBOX=ThrowbacksCulpeper@gmail.com
RECAPTCHA_SECRET_KEY=
